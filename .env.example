# Local environment placeholders — never commit real secrets.
# Copy to a local `.env` (gitignored) if your process manager loads it.

# Feature 013 — XT private account (legacy / regression). Use a key WITHOUT withdrawal permission.
XT_API_KEY=YOUR_API_KEY_HERE
XT_API_SECRET=YOUR_API_SECRET_HERE

# Feature 013 amendment — Kraken private account (read-only). Prefer a key WITHOUT withdrawal permission.
# Do not use these for order placement until Feature 015.
KRAKEN_API_KEY=YOUR_API_KEY_HERE
KRAKEN_API_SECRET=YOUR_API_SECRET_HERE

